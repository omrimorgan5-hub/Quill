import "../stdlib/random/random.qsc"
extern func strcmp(s: string, s2: string);

fn convert_to_play(s: string) {
    if(strcmp("rock\\n", s) == 0) {
        return 1;
    } else if(strcmp("paper\\n", s) == 0) {
        return 2;
    } else if(strcmp("scissors\\n", s) == 0) {
        return 3;
    } else {
        say "Unknown input\\n";
        return 99;
    }
}

let running: bool = true
let wins: number;
let ties: number;
let losses: number;
while (running) {
    let player: string;
    let computer: number;

    computer = quill_random_range(1, 3);
    printf("Enter your play (rock|paper|scissors): ")
    input(player);
    printf("\\n")

    let player_play: number = convert_to_play(player);

    if (player_play == computer) {
        say "Tie.\\n";
        ties++;
    } 
    else if (player_play == 1 && computer == 2) {
        say "Lose.\\n";
        losses++;
    } 
    else if (player_play == 1 && computer == 3) {
        say "Win\\n";
        wins++;
    } 
    else if (player_play == 2 && computer == 3) {
        say "Lose.\\n";
        losses++;
    } 
    else if (player_play == 2 && computer == 1) {
        say "Win\\n";
        wins++;
    } 
    else if (player_play == 3 && computer == 1) {
        say "Lose.\\n";
        losses++;
    } 
    else if (player_play == 3 && computer == 2) {
        say "Win\\n";
        wins++;
    } else {
        say "exiting..."
        say "\\n";
        say "Wins: " + wins +"\\n";
        say "Ties: " + ties +"\\n";
        say "Losses: " + losses +"\\n";
        running = false
    }
}