# ─── Variables ───────────────────────────────────────────────────────────────

let x = 10;
let name = "Quill";
let pi = 3.14;
let greeting = "Hello, " + name;

printf(greeting);
printf("x is: " + x);
printf("pi is: " + pi);

# ─── Reassignment ────────────────────────────────────────────────────────────

x = 20;
printf("x reassigned to: " + x);

# ─── Arithmetic ──────────────────────────────────────────────────────────────

let added = 10 + 5;
let sub = 10 - 3;
let mul = 6 * 7;
let div = 20 / 4;

printf("10 + 5 = " + added);
printf("10 - 3 = " + sub);
printf("6 * 7 = " + mul);
printf("20 / 4 = " + div);

# ─── Double arithmetic ────────────────────────────────────────────────────────

let radius = 5.0;
let area = pi * radius * radius;
printf("Circle area (approx): " + area);

# ─── String concatenation ────────────────────────────────────────────────────

let first = "Hello";
let second = " World";
let combined = first + second;
printf(combined);

# ─── Booleans ────────────────────────────────────────────────────────────────

let t = true;
let f = false;
printf("True is: " + t);
printf("False is: " + f);

# ─── Comparisons ─────────────────────────────────────────────────────────────

let a = 10;
let b = 20;

if (a < b) {
    say "a is less than b";
}

if (b > a) {
    say "b is greater than a";
}

if (a == 10) {
    say "a equals 10";
}

if (a != b) {
    say "a and b are not equal";
}

if (b >= 20) {
    say "b is greater than or equal to 20";
}

if (a <= 10) {
    say "a is less than or equal to 10";
}

# ─── If / else if / else ─────────────────────────────────────────────────────

let score = 60;

if (score >= 90) {
    say "Grade: A";
} else if (score >= 75) {
    say "Grade: B";
} else if (score >= 60) {
    say "Grade: C";
} else {
    say "Grade: F";
}

# ─── Nested conditionals ─────────────────────────────────────────────────────

let age = 20;
let hasID = true;

if (age >= 18) {
    if (hasID == true) {
        say "Entry allowed";
    } else {
        say "No ID, entry denied";
    }
} else {
    say "Too young for entry";
}

# ─── Logical operators ───────────────────────────────────────────────────────

let sunny = true;
let warm = true;

if (sunny == true && warm == true) {
    say "Great day for a walk";
}

let raining = false;

if (raining == false || sunny == true) {
    say "We can go outside";
}

# ─── While loop ──────────────────────────────────────────────────────────────

let i = 0;
while (i < 5) {
    printf("i = " + i);
    i = i + 1;
}

# ─── Loop accumulator ────────────────────────────────────────────────────────

let sum = 0;
let j = 1;
while (j <= 10) {
    sum = sum + j;
    j = j + 1;
}
printf("Sum 1 to 10 = " + sum);

# ─── Nested loops ────────────────────────────────────────────────────────────

let outer = 0;
while (outer < 3) {
    let inner = 0;
    while (inner < 3) {
        printf("outer=" + outer + " inner=" + inner);
        inner = inner + 1;
    }
    outer = outer + 1;
}

# ─── Functions ───────────────────────────────────────────────────────────────

func greet(name: string) {
    return "Hello, " + name + "!";
}

greet("Alice");
greet("Bob");

# ─── Function with arithmetic ────────────────────────────────────────────────

func square(n) {
    let n2 = n * n;
    printf(n + " squared = " + n2);
}

square(4);
square(9);

# ─── Function with conditional ───────────────────────────────────────────────

func isAdult(age) {
    if (age >= 18) {
        return "Is an adult";
    } else {
        return "Is not an adult";
    }
}

isAdult(20);
isAdult(15);

# ─── Function with loop ──────────────────────────────────────────────────────

func countUp(n) {
    let i = 0;
    while i < n {
        printf("count: " + i);
        i = i + 1;
    }
}

countUp(4);

# ─── Function called multiple times ─────────────────────────────────────────

func timesTwo(n) {
    let n2 = n * 2;
    printf(n + " doubled = " + n2);
}

timesTwo(3);
timesTwo(7);
timesTwo(12);

# ─── Standard library ────────────────────────────────────────────────────────

let strLen = len("Quill language");
printf("len of string = " + strLen);

# ─── Incrementation ──────────────────────────────────────────────────────────

let counter = 0;
counter++;
counter++;
counter++;
printf("counter after 3 increments: " + counter);

counter--;
printf("counter after decrement: " + counter);

# ─── Comments do not affect execution ────────────────────────────────────────

# this is a comment and should be ignored
let result = 100;
# another comment
printf("result = " + result);

# ─── Return statements early and end ────────────────────────────────────────
func add(a, b) {
    return a + b;
}

printf(result);

printf(isAdult(20));

# ─── End ─────────────────────────────────────────────────────────────────────
say "All tests complete.";